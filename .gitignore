# .gitignore
# ==========
# Files and folders Git should NEVER track.

# Python bytecode caches: auto-generated by Python every time code runs,
# differ per machine, and are rebuilt automatically.
__pycache__/
*.py[cod]

# pytest: cache of previous runs and temporary test folders (local only).
.pytest_cache/
.pytest_tmp/

# Virtual environments, in case you ever use venv instead of conda.
venv/
.venv/
env/

# Secrets: never commit real environment files.
.env

# Editor and OS clutter.
.vscode/
.idea/
.DS_Store
Thumbs.db
